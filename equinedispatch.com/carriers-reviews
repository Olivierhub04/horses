            $(document).on('click', '.account-delete-btn', function() {
                var $button = $(this);
                var vUniqueCode = $(this).data('unique-code');
                var alertTitle = $(this).data('alert-title');
                var alertMsg = $(this).data('alert-msg');
                var statusType = $button.data('status-type');
                var url = 'delete-account/_vUniqueCode'
                            .replace(':vUniqueCode', vUniqueCode);

                Swal.fire({
                    title: alertTitle,
                    text: alertMsg,
                    icon: 'warning',
                    showCancelButton: true,
                    cancelButtonColor: '#525252',
                    confirmButtonColor: "#B7973E",
                    confirmButtonText: 'Yes!',
                    preConfirm: () => {
                        Swal.getConfirmButton().style.display = 'none';
                        Swal.getCancelButton().style.display = 'none';
                        const loaderButtonHtml = `
                            <button type="button" class="swal2-confirm swal2-styled swal2-custom-loader-btn" aria-label="" style="background-color: rgb(183, 151, 62);">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                Submitting...
                            </button>
                        `;
                        $(Swal.getPopup()).find('.swal2-actions').append(loaderButtonHtml);
                        const $loaderButton = $('.swal2-confirm swal2-styled swal2-custom-loader-btn');
                        $loaderButton.show();

                        return new Promise((resolve, reject) => {
                            setTimeout(function() {
                                $.ajax({
                                    url: url,
                                    type: "POST",
                                    headers: {
                                        'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')
                                    },
                                    data: {},
                                    success: function (response) {
                                        toastr.success(response.message);

                                        // Update Swal alert on success
                                        Swal.update({
                                            title: 'Success!',
                                            text: 'Your account has been successfully deleted.',
                                            icon: 'success',
                                            showCancelButton: false,
                                            confirmButtonText: 'OK'
                                        });

                                        setTimeout(function() {
                                            window.location.href = "sign-up";
                                        }, 3000);
                                    },
                                    error: function() {
                                        toastr.error('An error occurred. Please try again.');
                                        reject();
                                    },
                                    complete: function() {
                                        $('.swal2-custom-loader-btn').remove();
                                    }
                                });
                            }, 1000);
                        });
                    }
                });
            });

