        <script>

        function get_review(pages = '')
        {
            $("#div_record").html(`<div style="height: 150px; width: 100px; margin: auto;">
                    <img src="https://equinedispatch.com/assets/loader.gif" style="" alt="loader">
                </div>`);

            setTimeout(function() {
                $.ajax({
                    url: "https://equinedispatch.com/front/carriers/ajax-listing",
                    type: "POST",
                    headers: {'X-CSRF-TOKEN': $('meta[name="csrf-token"]').attr('content')},
                    data: {pages:pages},
                    success: function(response) {
                        $("#div_record").html(response);
                    }
                });
            }, 1000);
        }

        $(document).ready(function() {

            get_review();

            $(document).on('click', '.read-more', function() {
                var $container = $(this).closest('.shipper-review-box');
                var $moreText = $container.find('.more-text');
                var $shortDescription = $container.find('.more-data');
                var $dots = $container.find('.dots');
                var $readLessLink = $container.find('.read-less');

                if ($moreText.is(':hidden')) {
                    $dots.hide();
                    $shortDescription.hide();
                    $readLessLink.show();
                    $(this).text("Read Less");
                    $moreText.show();
                } else {
                    $dots.show();
                    $shortDescription.show();
                    $readLessLink.hide();
                    $(this).text("Read More");
                    $moreText.hide();
                }
            });


            $(document).on('click', '.ajax_page', function() {
                var vPages = $(this).data("pages");

                get_review(vPages);
            });
        });

    </script>
